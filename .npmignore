# Ignore everything by default
*

# Include what we need (and their contents)
!src/
!src/**
!ios/
!ios/**
!android/
!android/**
!react-native-fast-cache.podspec
!react-native.config.js
!package.json
!README.md
!LICENSE

# Exclude build artifacts
android/build/
android/.gradle/
ios/build/
*.xcworkspace
*.xcodeproj

# Exclude assets from npm package
# (README images won't render on npmjs.com if hosted here)
# Keep assets only in the repo, not in the published tarball

# Exclude example app
example/
__tests__/
node_modules/
vendor/
assets/

