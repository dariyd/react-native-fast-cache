# Ignore everything by default
*

# Include what we need (and their contents)
!src/
!src/**
!ios/
!ios/**
!android/
!android/**
!react-native-fast-cache.podspec
!react-native.config.js
!package.json
!README.md
!LICENSE

# Exclude build artifacts
android/build/
android/.gradle/
ios/build/
*.xcworkspace
*.xcodeproj

# Include assets used by README (for npm page rendering)
!assets/
!assets/**

# Exclude example app
example/
__tests__/
node_modules/
vendor/

